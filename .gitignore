# macOS
.DS_Store

# Editor / tooling
.superpowers/
.claude/

# Logs / temp
*.log
/tmp/

# Local server
serve.py

# Original full-resolution exports. Kept locally so optimize-images.py can
# re-derive at any quality, but never committed or published: ~48 MB of pixels
# no visitor downloads.
#
# NOT RECOVERABLE. This comment used to claim "recoverable from git history
# (commit e31a246) if lost" -- that was false and dangerously so. e31a246 is
# "Add toolkit chips with drop-in icon support" and touches no image at all.
# No file under projects/*/assets/_src/ has ever been committed to this repo,
# on any branch, in any reflog entry, or in any stash. The working tree is the
# only copy. Back these up outside git; `git checkout` will not bring them back.
projects/*/assets/_src/

# Same rule, same reason. This one was missed: the pattern above is anchored to
# projects/, so site/_src/ stayed tracked and shipped 1.6 MB of originals whose
# derivatives sit right beside them.
site/_src/

# Working notes — candid, and not for public reading.
notes/

# Build bookkeeping
.image-renames.json
