{
  "_note": "Dark scheme. Surfaces are a scale rather than one flat black, and raised surfaces are white at low alpha so they pick up whatever sits behind them. Three faces, all SIL OFL and self-hosted in assets/fonts (no CDN at runtime): Blinker for UI and body, Sulphur Point for display headings, Anton for the poster type in the hero wall and the wordmark. Display steps 3xl-5xl are fluid clamps so oversized headings scale with the viewport instead of needing breakpoints. These values are this site's own, not extracted from any client or employer file - the work shown in the case studies is governed by its own systems.",
  "color": {
    "bg": "#02050C",
    "bgAlt": "#070C18",
    "bgRaised": "rgba(255,255,255,0.038)",
    "bgRaisedHover": "rgba(255,255,255,0.065)",
    "bgInverse": "#F4F4F2",
    "text": "#EDEDEB",
    "textMuted": "rgba(212,212,212,0.68)",
    "textFaint": "rgba(212,212,212,0.62)",
    "textInverse": "#02050C",
    "border": "rgba(255,255,255,0.09)",
    "borderStrong": "rgba(255,255,255,0.18)",
    "accent": "#5EEAD4",
    "accentSoft": "rgba(94,234,212,0.14)",
    "accentText": "#04211C"
  },
  "font": {
    "sans": "'Blinker', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "display": "'Sulphur Point', 'Blinker', Helvetica, Arial, sans-serif",
    "mono": "'SF Mono', ui-monospace, Menlo, monospace",
    "poster": "'Anton', 'Arial Narrow', 'Haettenschweiler', sans-serif"
  },
  "fontSize": {
    "xs": "0.8125rem",
    "sm": "0.9375rem",
    "base": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "2.25rem",
    "3xl": "clamp(2.75rem, 7vw, 4.5rem)",
    "4xl": "clamp(3.5rem, 13vw, 11rem)",
    "5xl": "clamp(4rem, 17vw, 16rem)"
  },
  "lineHeight": {
    "tight": "1.04",
    "snug": "1.3",
    "normal": "1.6"
  },
  "fontWeight": {
    "light": "300",
    "regular": "400",
    "medium": "600",
    "bold": "800"
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
    "32": "8rem"
  },
  "radius": {
    "sm": "4px",
    "md": "10px",
    "lg": "18px",
    "full": "999px"
  },
  "layout": {
    "maxWidth": "1200px",
    "proseWidth": "68ch",
    "gutter": "1.5rem",
    "headerHeight": "5.5rem"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "900px",
    "lg": "1200px"
  },
  "ease": {
    "out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "spring": "cubic-bezier(0.34, 1.3, 0.5, 1)",
    "reveal": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "filter": {
    "mono": "grayscale(1) contrast(1.4) brightness(1.02)"
  },
  "cursor": {
    "points": "60",
    "spring": "0.4",
    "damping": "0.5",
    "smooth": "2",
    "lineWidth": "0.6",
    "opacity": "0.06",
    "blur": "9",
    "velocityScale": "1",
    "blend": "source-over"
  }
}
